digraph AvilaOS {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.34", ranksep="0.7", splines=polyline, fontname="Helvetica", fontsize=14, label="UML de clases principales - vista selectiva", labelloc=t];
  node [shape=plain, fontname="Helvetica", fontsize=14, color="#183648", style=filled, fillcolor="#F4F7F9", margin="0.12,0.09"];
  edge [fontname="Helvetica", fontsize=11, color="#476477", arrowsize=0.75];
  UiSession [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>UiSession</B></TD></TR><TR><TD ALIGN="LEFT">- engine: Simulation<BR ALIGN="LEFT"/>- worker: Thread<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ loadScenario(path)<BR ALIGN="LEFT"/>+ requestClose()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Simulation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>Simulation</B></TD></TR><TR><TD ALIGN="LEFT">- computers: Computer[]<BR ALIGN="LEFT"/>- workers: ComputerWorker[]<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ advanceCycle(cycle)<BR ALIGN="LEFT"/>+ snapshot()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ClockDriver [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>«interface»<BR/>ClockDriver</B></TD></TR><TR><TD ALIGN="LEFT">+ advanceCycle(cycle)<BR ALIGN="LEFT"/>+ publishState(...)<BR ALIGN="LEFT"/>+ shutdown()<BR ALIGN="LEFT"/></TD></TR></TABLE>>,fillcolor="#DCEFF0"];
  GlobalClock [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>GlobalClock</B></TD></TR><TR><TD ALIGN="LEFT">- driver: ClockDriver<BR ALIGN="LEFT"/>- thread: Thread<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ step() / pause()<BR ALIGN="LEFT"/>+ resume() / stop()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Worker [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>ComputerWorker</B></TD></TR><TR><TD ALIGN="LEFT">- target: Tickable<BR ALIGN="LEFT"/>- thread: Thread<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ executeCycle(cycle)<BR ALIGN="LEFT"/>+ close()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Computer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>Computer</B></TD></TR><TR><TD ALIGN="LEFT">- cpu: Cpu<BR ALIGN="LEFT"/>- ram: Ram<BR ALIGN="LEFT"/>- io: IoController<BR ALIGN="LEFT"/>- kernel: Kernel<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ onTick(cycle)<BR ALIGN="LEFT"/>+ submit(pcb)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Tickable [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>«interface»<BR/>Tickable</B></TD></TR><TR><TD ALIGN="LEFT">+ onTick(cycle)<BR ALIGN="LEFT"/></TD></TR></TABLE>>,fillcolor="#DCEFF0"];
  Kernel [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>Kernel</B></TD></TR><TR><TD ALIGN="LEFT">- incoming / blocked<BR ALIGN="LEFT"/>- ready / terminated<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ onTick(cycle)<BR ALIGN="LEFT"/>+ unblockExternal(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Scheduler [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>Scheduler</B></TD></TR><TR><TD ALIGN="LEFT">- ready: OrderedProcessQueue<BR ALIGN="LEFT"/>- policy: SchedulingPolicy<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ select()<BR ALIGN="LEFT"/>+ shouldPreempt(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Policy [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>«interface»<BR/>SchedulingPolicy</B></TD></TR><TR><TD ALIGN="LEFT">+ select(ready)<BR ALIGN="LEFT"/>+ shouldPreempt(...)<BR ALIGN="LEFT"/>+ reorder(ready)<BR ALIGN="LEFT"/></TD></TR></TABLE>>,fillcolor="#DCEFF0"];
  PCB [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>ProcessControlBlock</B></TD></TR><TR><TD ALIGN="LEFT">- state / blockReason<BR ALIGN="LEFT"/>- pc / mar / assignedMemory<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ dispatch(cycle)<BR ALIGN="LEFT"/>+ block(reason)<BR ALIGN="LEFT"/>+ terminate(reason,cycle)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Buffers [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>BufferService</B></TD></TR><TR><TD ALIGN="LEFT">- registry: BufferRegistry<BR ALIGN="LEFT"/>- mutex: Semaphore<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ beginCycle(cycle)<BR ALIGN="LEFT"/>+ afterInstruction(...)<BR ALIGN="LEFT"/>+ cleanup(...)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Buffer [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>BoundedBuffer</B></TD></TR><TR><TD ALIGN="LEFT">- items: RingBuffer<BR ALIGN="LEFT"/>- empty / full / mutex<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ insert(pcb,item)<BR ALIGN="LEFT"/>+ remove(pcb)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Semaphore [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>SimulatedSemaphore</B></TD></TR><TR><TD ALIGN="LEFT">- value: int<BR ALIGN="LEFT"/>- waiting: LinkedList<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ waitFor(pcb)<BR ALIGN="LEFT"/>+ signal()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Metrics [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#183648" BGCOLOR="#F4F7F9"><TR><TD ALIGN="CENTER" BGCOLOR="#DCEFF0"><B>MetricsSnapshot</B></TD></TR><TR><TD ALIGN="LEFT">- global: PerformanceMetrics<BR ALIGN="LEFT"/>- waits: SemaphoreWaitMetrics<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ global()<BR ALIGN="LEFT"/>+ computerAt(index)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  {rank=same;UiSession;Simulation;ClockDriver;}
  {rank=same;Kernel;Scheduler;}
  UiSession -> Simulation [dir=both,arrowtail=diamond,arrowhead=none,label="0..1",constraint=false];
  Simulation -> ClockDriver [style=dashed,arrowhead=empty,label="realiza",constraint=false];
  Simulation -> GlobalClock [dir=both,arrowtail=diamond,arrowhead=none,label="1"];
  Simulation -> Worker [dir=both,arrowtail=diamond,arrowhead=none,label="2..*"];
  Simulation -> Computer [dir=both,arrowtail=diamond,arrowhead=none,label="2..*",constraint=false];
  Simulation -> Buffers [dir=both,arrowtail=diamond,arrowhead=none,label="1"];
  Simulation -> Metrics [label="publica"];
  Worker -> Computer [label="target",headlabel="1"];
  Computer -> Tickable [style=dashed,arrowhead=empty,label="realiza",constraint=false];
  Computer -> Kernel [dir=both,arrowtail=diamond,arrowhead=none,label="1"];
  Kernel -> Scheduler [dir=both,arrowtail=diamond,arrowhead=none,label="1",constraint=false];
  Scheduler -> Policy [label="1; estrategia"];
  Kernel -> PCB [label="registra 0..*"];
  Kernel -> Buffers [style=dashed,label="usa",constraint=false];
  Buffers -> Buffer [style=dashed,label="gestiona vía\nBufferRegistry"];
  Buffer -> Semaphore [dir=both,arrowtail=diamond,arrowhead=none,label="3"];
}
